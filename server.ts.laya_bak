app.post('/api/keys/generate', (req: Request, res: Response) => {
  const { label = 'Auto-Generated Key', pin = '123456' } = req.body;
  const pool = InfiniteTokenPool.getInstance();
  const newKey = pool.generateNewApiKey(label, pin);
  res.json({
    success: true,
